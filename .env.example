# AgriSathi AI Environment Configuration
# Add your API keys here or configure directly from the App Settings UI

# Groq Cloud API Key (Free from https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini API Key (Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Default Provider: local, groq, or gemini
DEFAULT_AI_PROVIDER=local
